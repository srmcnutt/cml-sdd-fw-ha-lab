# Copy to .lab-creds.env (git-ignored) and fill in the real values.
# Read by scripts/lablib.py (FMC and CML REST) and by .mcp.json (CML 2.10 MCP server).
# FMC_HOST is a bare host or address; CML_HOST includes the scheme, no trailing slash.
FMC_HOST=198.18.129.31
FMC_USER=api-user
FMC_PASS=change-me
CML_HOST=https://198.18.128.2
CML_USER=admin
CML_PASS=change-me
# Device login the MCP server's send_cli_command uses (IOS XE routers and switches).
# Must match the username/secret in configs/routers/*.cfg and configs/switches/*.cfg.
DEVICE_USER=admin
DEVICE_PASS=change-me
