{
  "docker": {
    "image": "net-tools:1.0.0",
    "mounts": [
      "type=bind,source=cfg/boot.sh,target=/boot.sh"
    ]
  },
  "caps": [
    "CAP_CHOWN",
    "CAP_DAC_OVERRIDE",
    "CAP_FOWNER",
    "CAP_FSETID",
    "CAP_KILL",
    "CAP_MKNOD",
    "CAP_NET_BIND_SERVICE",
    "CAP_NET_RAW",
    "CAP_SETFCAP",
    "CAP_SETGID",
    "CAP_SETPCAP",
    "CAP_SETUID",
    "CAP_SYS_CHROOT",
    "NET_ADMIN",
    "SYS_ADMIN"
  ],
  "day0cmd": [ "/bin/bash", "/boot.sh" ],
  "busybox": true
}
